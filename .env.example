# MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mental-health-app

# JWT secret (min 32 chars in production)
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Optional: Mindful Forest ambient audio (CC0 / royalty-free URL for testing)
# Replace with your own hosted file in production.
FOREST_AUDIO_URL=https://cdn.pixabay.com/audio/2022/03/15/audio_8cb7499ede.mp3

# App URL (for cookies in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
