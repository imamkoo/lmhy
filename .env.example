# URL publik situs (dipakai untuk sitemap, robots, canonical, OpenGraph)
# Production: https://letmehearyou.id
# Local dev  : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://letmehearyou.id
NEXT_PUBLIC_WA_GROUP_URL=

# Opsional: audio ambient Mindful Forest (CC0 / royalty-free)
NEXT_PUBLIC_FOREST_AUDIO_URL=

# ==============================================================================
# SUPABASE (POSTGRESQL DATABASE, AUTH & STORAGE)
# ==============================================================================
# URL instance Supabase project Anda (didapat dari Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / Public API Key Supabase (aman untuk browser/client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Secret Supabase (HANYA server-side, TIDAK BOLEH diekspos ke browser / NEXT_PUBLIC_)
# Wajib diset di Vercel Production Environment untuk mengizinkan webhook Litera
# (Server-to-Server) mengupdate kolom status NFT artikel melewati RLS.
# WAJIB juga untuk: /admin (antrean verifikasi mitra), bootstrap admin, sweep & purge dokumen.
SUPABASE_SERVICE_ROLE_KEY=

# Secret khusus untuk menandatangani token unggah dokumen mitra. Buat dengan: openssl rand -hex 32
# WAJIB: tanpa ini, submit pengajuan mitra akan gagal ("Token unggah belum dikonfigurasi").
MITRA_UPLOAD_SECRET=

# ==============================================================================
# ROLLOUT FLAG JALUR PENGAJUAN MITRA (SP-1)
# ==============================================================================
# Master switch seluruh jalur kemitraan. "false" = form intake dimatikan.
NEXT_PUBLIC_MITRA_INTAKE_ENABLED=false
# Sakelar per jalur (hanya dibaca jika master switch "true")
NEXT_PUBLIC_MITRA_INTAKE_PSIKOLOG_ENABLED=false
NEXT_PUBLIC_MITRA_INTAKE_PENDAMPING_ENABLED=false
# Shadow mode: pengajuan tetap masuk antrean, tetapi approve/reject dinonaktifkan.
MITRA_INTAKE_SHADOW_MODE=false
# Whitelist email (pisahkan dengan koma). Kosong = semua email boleh.
MITRA_INTAKE_WHITELIST_EMAILS=
# UUID admin sistem yang dipakai sebagai actor saat sweep otomatis berjalan.
# Kosong = fallback ke actor_id terakhir di admin_audit_log.
ADMIN_SYSTEM_ACTOR_ID=

# Secret untuk memanggil endpoint sweep kedaluwarsa (POST /api/internal/sweep).
# Dibuat dengan: openssl rand -hex 32
# WAJIB untuk cron harian; tanpa ini endpoint mengembalikan 404.
SWEEP_SECRET=

# Secret untuk Vercel Cron. Vercel mengirim header "Authorization: Bearer $CRON_SECRET"
# otomatis saat memanggil endpoint cron. Boleh bernilai sama dengan SWEEP_SECRET.
# https://vercel.com/docs/cron-jobs/manage-cron-jobs
CRON_SECRET=

# Base URL aplikasi untuk script cron sweep (dipakai scripts/sweep-expired-applications.mjs)
APP_URL=https://letmehearyou.id

# ==============================================================================
# EMAIL NOTIFIKASI (RESEND ATAU BREVO — pilih salah satu)
# ==============================================================================
# Resend (prioritas pertama bila keduanya terisi)
RESEND_API_KEY=
# Brevo (fallback)
BREVO_API_KEY=
# Sender email. Format: "Let Me Hear You <halo@letmehearyou.com>"
EMAIL_FROM=

# ==============================================================================
# LITERA PROTOCOL (S2S REST API & PUBLISHER MASTER KEY)
# ==============================================================================
# Master Secret Key Publisher yang didapat dari Dashboard Litera (https://literaa.xyz)
# Menu: "Kunci API & Domain Publisher" -> Format: lit_sk_...
LITERA_API_KEY=

# Optional: dedicated webhook HMAC secret (if different from LITERA_API_KEY)
# LITERA_WEBHOOK_SECRET=

# Base URL Litera REST API (Default Production: https://literaa.xyz/api/v1)
LITERA_API_URL=https://literaa.xyz/api/v1

# Base URL Dashboard & Cloud Auth Widget (Default: https://literaa.xyz)
NEXT_PUBLIC_LITERA_DASHBOARD_URL=https://literaa.xyz

# ==============================================================================
# MIDTRANS (SANCTUARY STUDIO SESSIONS — QRIS)
# ==============================================================================
# Server Key (HANYA server-side, TIDAK BOLEH diekspos ke browser / NEXT_PUBLIC_)
MIDTRANS_SERVER_KEY=
# Client Key (aman untuk browser, dipakai snap.js)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Lingkungan Midtrans: sandbox | production
MIDTRANS_ENV=sandbox
